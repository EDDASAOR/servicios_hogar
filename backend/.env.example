# ──────────────────────────────────────────────
# Variables de entorno para producción (Railway)
# Copia estos valores en el panel de Railway
# ──────────────────────────────────────────────

# Conexión a MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/hogarpro?retryWrites=true&w=majority&appName=Cluster0

# Secreto para firmar los JWT (usa un valor largo y aleatorio)
JWT_SECRET=cambia_esto_por_un_secreto_muy_seguro

# URL del frontend en Vercel (Railway la usa para CORS)
FRONTEND_URL=https://servicios-hogar.vercel.app

# Webhook de Make/Integromat (si lo usas)
MAKE_WEBHOOK_URL=https://hook.us2.make.com/tu_webhook_aqui

# Puerto (Railway lo asigna automáticamente — NO lo cambies)
# PORT=3000
